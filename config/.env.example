# AutoClip Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Provider API Keys (choose one or more)
# ============================================================================
AUTOCLIP_OPENAI_KEY=your-openai-or-nvidia-nim-or-openrouter-api-key
AUTOCLIP_ANTHROPIC_KEY=your-anthropic-api-key
AUTOCLIP_GEMINI_KEY=your-gemini-api-key

# Active provider: openai, anthropic, gemini, ollama
AUTOCLIP_ACTIVE_PROVIDER=openai

# ============================================================================
# Option 1: NVIDIA NIM (FREE - Recommended)
# Get free API key at: https://build.nvidia.com/
# Model: nvidia/nemotron-3.5-super-vl-120b-a2b
# ============================================================================
# AUTOCLIP_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# AUTOCLIP_OPENAI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a2b

# ============================================================================
# Option 2: OpenRouter (FREE tier available)
# Get free API key at: https://openrouter.ai/
# Models: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, meta-llama/llama-3.1-405b, etc.
# ============================================================================
# AUTOCLIP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AUTOCLIP_OPENAI_MODEL=anthropic/claude-3.5-sonnet

# ============================================================================
# Option 3: Official OpenAI (PAID)
# Get API key at: https://platform.openai.com/
# ============================================================================
# AUTOCLIP_OPENAI_BASE_URL=https://api.openai.com/v1
# AUTOCLIP_OPENAI_MODEL=gpt-4o-mini

# Uncomment ONE of the above base_url + model pairs based on your provider

# ============================================================================
# Whisper settings (Transcription)
# ============================================================================
AUTOCLIP_WHISPER_MODEL=tiny
AUTOCLIP_WHISPER_COMPUTE_TYPE=int8
AUTOCLIP_WHISPER_LANGUAGE=

# ============================================================================
# Clip settings
# ============================================================================
AUTOCLIP_CLIPS_MIN_DURATION=20
AUTOCLIP_CLIPS_MAX_DURATION=90
AUTOCLIP_CLIPS_MAX_CLIPS=3

# ============================================================================
# Export settings
# ============================================================================
AUTOCLIP_EXPORT_RATIO=9:16
AUTOCLIP_EXPORT_CAPTION_STYLE=bold_pop
AUTOCLIP_EXPORT_LOUDNESS=-14
AUTOCLIP_EXPORT_PREFER_HARDWARE_ENCODER=true
AUTOCLIP_EXPORT_CRF=18

# ============================================================================
# YouTube Upload Settings (OAuth 2.0)
# Get credentials at: https://console.cloud.google.com/
# Enable YouTube Data API v3, create OAuth 2.0 Client ID
# ============================================================================
AUTOCLIP_YOUTUBE_CLIENT_ID=your-youtube-client-id.apps.googleusercontent.com
AUTOCLIP_YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
AUTOCLIP_YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback